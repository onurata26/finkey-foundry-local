# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# misc
.DS_Store
*.pem
/.idea/
/.vscode/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# local environment files
.env*
.dev.vars*
!.env.example

# typescript
next-env.d.ts
*.tsbuildinfo
/dist/
/outputs/
/work/

# Local-only application state. This includes Foundry Local model weights,
# uploaded document chunks, embeddings and SQLite databases.
/data/
/uploads/
/:memory:
*.sqlite
*.sqlite-shm
*.sqlite-wal
*.sqlite-journal
*.gguf
*.onnx
*.onnx.data

# local visual audit evidence
/product-design-audit/
/artifacts/
